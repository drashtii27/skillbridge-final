# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/skillbridge

# ── JWT ───────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-32char-string

# ── LLM: Ollama (local, primary) ──────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=nemotron-mini

# ── LLM: OpenRouter (fallback, free tier) ─────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/llama-3.1-nemotron-nano-8b-instruct:free

# ── PostHog Analytics ─────────────────────────────────────
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# ── Job Listings (Adzuna) ─────────────────────────────────
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ── Frontend (Next.js) ────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
